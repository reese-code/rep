{%- comment -%}
  AR Product Grid — App Block
  ---------------------------
  Renders a grid of product cards from a chosen collection. Cards whose
  product has 3D model media get a "3D" badge; clicking one opens a quick
  view: an inline <model-viewer> (rotate/zoom only, no AR) on one side and
  a panel with the product's description and options on the other. AR
  itself is opt-in from inside that quick view via a small globe button in
  the bottom-right corner of the viewer — tapping it launches AR Quick
  Look on iOS Safari or Scene Viewer/WebXR on Android Chrome, whichever
  the device actually supports, with no manual platform picker.
{%- endcomment -%}

{%- assign apg_products = block.settings.collection.products -%}

<div class="apg" id="apg-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="apg__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {%- if apg_products.size == 0 -%}
    {%- if request.design_mode -%}
      <p class="apg__setup-note">Pick a collection above. Products with a 3D model in their media get a clickable 3D viewer; others render as plain cards.</p>
    {%- endif -%}
  {%- else -%}
    <div class="apg__grid" data-apg-root>
      {%- for product in apg_products -%}
        {%- assign apg_model = product.media | where: 'media_type', 'model' | first -%}
        <button
          type="button"
          class="apg-card{% if apg_model %} apg-card--has-model{% endif %}"
          {%- if apg_model %} data-apg-open="apg-content-{{ block.id }}-{{ product.id }}"{% endif %}
          {%- unless apg_model %} disabled{% endunless %}
        >
          <span class="apg-card__media">
            {%- if product.featured_media -%}
              {{ product.featured_media.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title, class: 'apg-card__image' }}
            {%- endif -%}
            {%- if apg_model -%}
              <span class="apg-card__badge">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>
                3D
              </span>
            {%- endif -%}
          </span>
          <span class="apg-card__title">{{ product.title }}</span>
          <span class="apg-card__price">{{ product.price | money }}</span>
        </button>
      {%- endfor -%}
    </div>

    {%- for product in apg_products -%}
      {%- assign apg_model = product.media | where: 'media_type', 'model' | first -%}
      {%- if apg_model -%}
        {%- assign apg_glb = apg_model.sources | where: 'format', 'glb' | first -%}
        {%- assign apg_usdz = apg_model.sources | where: 'format', 'usdz' | first -%}
        <template id="apg-content-{{ block.id }}-{{ product.id }}">
          <div class="apg-modal__viewer">
            <model-viewer
              src="{{ apg_glb.url }}"
              {%- if apg_usdz %} ios-src="{{ apg_usdz.url }}"{% endif %}
              alt="{{ apg_model.alt | default: product.title }}"
              ar
              ar-modes="webxr scene-viewer quick-look"
              camera-controls
              auto-rotate
              shadow-intensity="1"
              exposure="1"
            >
              <button slot="ar-button" type="button" class="apg-globe-btn" aria-label="View in the world">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>
                </svg>
                <span class="apg-tooltip">View in the world</span>
              </button>
            </model-viewer>
          </div>
          <div class="apg-modal__panel">
            <h3 class="apg-modal__title">{{ product.title }}</h3>
            <div class="apg-modal__price">{{ product.price | money }}</div>
            <div class="apg-modal__description">{{ product.description }}</div>
            {%- if product.options_with_values.size > 0 -%}
              <div class="apg-modal__addons">
                <h4>Add-ons</h4>
                {%- for option in product.options_with_values -%}
                  <div class="apg-option">
                    <label>{{ option.name }}</label>
                    <select>
                      {%- for value in option.values -%}
                        <option>{{ value }}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <a class="apg-modal__link" href="{{ product.url }}">View full product page</a>
          </div>
        </template>
      {%- endif -%}
    {%- endfor -%}

    <dialog class="apg-modal" data-apg-modal>
      <button type="button" class="apg-modal__close" data-apg-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <div class="apg-modal__body" data-apg-modal-body></div>
    </dialog>
  {%- endif -%}
</div>

{{ 'ar-product-grid.css' | asset_url | stylesheet_tag }}
<script type="module" src="https://unpkg.com/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>
<script src="{{ 'ar-product-grid.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AR Product Grid",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop in 3D"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ]
}
{% endschema %}
