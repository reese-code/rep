{%- comment -%}
  Room-Aware Builder — AR Concept Section
  -------------------------------------
  Independent portfolio concept by Latimer Design, built into the REP
  Fitness theme. Not an official REP Fitness feature.

  Covers both mobile AR paths with no native app required:
    - Android / Chrome: WebXR capability check (real navigator.xr call)
    - iOS / Safari: AR Quick Look (real ARKit-backed <a rel="ar"> launch)
  Both fall back to manual room-dimension entry, which feeds the same
  clearance/canvas/recommendation logic either way.

  Self-contained: uses its own "ar-room-scan-builder__" prefixed classes
  and does not depend on theme-specific button/layout utility classes.
{%- endcomment -%}

<section
  class="ar-room-scan-builder color-{{ section.settings.color_scheme }}"
  id="ar-room-scan-builder-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="ar-room-scan-builder__container">
    <div class="ar-room-scan-builder__tag">
      Concept extension to the REP Rack Builder — independent portfolio project by Latimer Design, not an official REP Fitness feature.
    </div>

    <div class="ar-room-scan-builder__inner">
      <div class="ar-room-scan-builder__header">
        <p class="ar-room-scan-builder__eyebrow">{{ section.settings.eyebrow | default: 'Room-Aware Builder — Concept' }}</p>
        <h2 class="ar-room-scan-builder__heading">{{ section.settings.heading | default: 'Scan the room. Build the gym.' }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="ar-room-scan-builder__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="ar-room-scan-builder__stage" data-rsb-root>

        <div class="ar-room-scan-builder__step is-active" data-rsb-step="scan">
          <div class="ar-room-scan-builder__xr-status" data-rsb-xr-status>
            Checking this device for AR room-scanning support…
          </div>

          <div class="ar-room-scan-builder__panel" data-rsb-quicklook-panel hidden>
            <div class="ar-room-scan-builder__panel-label">
              <span>View in Your Space</span><span>AR Quick Look — iOS</span>
            </div>
            <p class="ar-room-scan-builder__quicklook-copy">Safari doesn't support WebXR, but it has its own native AR path: Quick Look, built on ARKit. This is very likely the same mechanism behind REP's existing "view in your space" feature.</p>
            <a data-rsb-quicklook-link rel="ar" href="#" class="ar-room-scan-builder__btn ar-room-scan-builder__btn--primary ar-room-scan-builder__quicklook-btn">
              View Placeholder Model in AR
            </a>
            <p class="ar-room-scan-builder__quicklook-disclaimer">Placeholder model from Apple's public Quick Look gallery — standing in for a real REP rack USDZ, which would need to be exported from REP's actual 3D assets. Quick Look itself is real; this file is not the rack.</p>
          </div>

          <div class="ar-room-scan-builder__panel" data-rsb-manual-panel hidden>
            <div class="ar-room-scan-builder__panel-label">
              <span>Room Dimensions</span><span>Manual Entry</span>
            </div>
            <div class="ar-room-scan-builder__field">
              <label for="rsb-width-{{ section.id }}">Back wall width (inches)</label>
              <input type="number" id="rsb-width-{{ section.id }}" data-rsb-input="width" value="110" min="40" max="300">
            </div>
            <div class="ar-room-scan-builder__field">
              <label for="rsb-depth-{{ section.id }}">Room depth (inches)</label>
              <input type="number" id="rsb-depth-{{ section.id }}" data-rsb-input="depth" value="84" min="40" max="300">
            </div>
            <div class="ar-room-scan-builder__field">
              <label for="rsb-ceiling-{{ section.id }}">Ceiling height (inches)</label>
              <input type="number" id="rsb-ceiling-{{ section.id }}" data-rsb-input="ceiling" value="84" min="60" max="180">
            </div>
            <button type="button" class="ar-room-scan-builder__btn ar-room-scan-builder__btn--primary" data-rsb-action="confirm-room">Confirm Room</button>
          </div>
        </div>

        <div class="ar-room-scan-builder__step" data-rsb-step="rack">
          <div class="ar-room-scan-builder__panel">
            <div class="ar-room-scan-builder__panel-label">
              <span>Your Room</span><span data-rsb-room-summary></span>
            </div>
          </div>

          <div class="ar-room-scan-builder__panel">
            <div class="ar-room-scan-builder__panel-label"><span>Choose Rack</span><span>REP Catalog</span></div>
            <div class="ar-room-scan-builder__field">
              <label for="rsb-rack-{{ section.id }}">Model</label>
              <select id="rsb-rack-{{ section.id }}" data-rsb-select="rack"></select>
            </div>
            <div class="ar-room-scan-builder__field">
              <label for="rsb-height-{{ section.id }}">Height option</label>
              <select id="rsb-height-{{ section.id }}" data-rsb-select="height"></select>
            </div>
          </div>

          <div data-rsb-clearance-output></div>

          <button type="button" class="ar-room-scan-builder__btn ar-room-scan-builder__btn--primary" data-rsb-action="place-rack">Place in Room</button>
        </div>

        <div class="ar-room-scan-builder__step" data-rsb-step="canvas">
          <div class="ar-room-scan-builder__panel">
            <div class="ar-room-scan-builder__panel-label">
              <span>Your Home Gym Layout</span><span data-rsb-canvas-room-size></span>
            </div>
            <div class="ar-room-scan-builder__room-canvas" data-rsb-canvas></div>
            <p class="ar-room-scan-builder__canvas-caption">Top-down view, scaled to your scanned room</p>
          </div>

          <div class="ar-room-scan-builder__panel">
            <div class="ar-room-scan-builder__panel-label">
              <span>Fits Your Remaining Space</span><span data-rsb-open-space></span>
            </div>
            <div data-rsb-reco-list></div>
          </div>

          <button type="button" class="ar-room-scan-builder__btn ar-room-scan-builder__btn--secondary" data-rsb-action="restart">Rescan Room</button>
        </div>

      </div>
    </div>
  </div>
</section>

{{ 'ar-room-scan-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ar-room-scan-engine.js' | asset_url }}" defer></script>
<script src="{{ 'ar-room-scan-builder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Room-Aware Builder (AR)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Portfolio concept section by Latimer Design. Demonstrates a room-scanning extension to the existing REP Rack Builder AR feature. Covers both Android (WebXR) and iOS (AR Quick Look) without a native app."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Room-Aware Builder — Concept"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Scan the room. Build the gym."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "An extension to REP's existing rack builder and AR placement: scan your space, and every build is checked against your real room."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Room-Aware Builder (AR)"
    }
  ]
}
{% endschema %}
